DATABASE_URL="mysql2://venganzas_del_pasado:xxxxx@host.docker.internal:3306/venganzas_del_pasado_production"
SECRET_KEY_BASE="xxxxx"
REDIS_URL="redis://valkey:6379/0"

# Must contain at least 16 bytes because MeiliSearch runs in production mode.
MEILISEARCH_HOST="http://meilisearch:7700"
MEILISEARCH_API_KEY="replace-with-a-long-random-key"

RECAPTCHA_SITE_KEY="xxxxx"
RECAPTCHA_SECRET_KEY="xxxxx"
AUDIO_API_USER_EMAIL="juan@schwindt.org"
AUDIO_API_SECRET_TOKEN="xxxxx"
VDP_AUDIO_PIPELINE_API_TOKEN="replace-with-a-long-random-token"

RAILS_ASSUME_SSL=true
RAILS_FORCE_SSL=true
RAILS_LOG_LEVEL=info
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=3
