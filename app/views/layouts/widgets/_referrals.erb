<% affiliate_links = AffiliateLink.random_active %>

<% if affiliate_links.any? %>
  <h3 class="title title-right is-4">
    Compras afiliadas
  </h3>
  <div class="content">
    <div class="referrals">
      <% affiliate_links.each do |affiliate_link| %>
        <%= link_to affiliate_link.affiliate_url,
              class: "referral-card",
              target: "_blank",
              rel: "noopener sponsored" do %>
          <% if affiliate_link.image_url.present? %>
            <%= image_tag affiliate_link.image_url, alt: affiliate_link.name, class: "referral-card-image" %>
          <% end %>
          <span class="referral-card-title"><%= affiliate_link.name %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
